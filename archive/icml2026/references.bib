@article{janssen2011coordination,
    title={Coordination and cooperation in asymmetric commons dilemmas},
    author={Janssen, Marco A and Anderies, John M and Joshi, Sanket R},
    journal={Experimental Economics},
    volume={14},
    number={4},
    pages={547--566},
    year={2011},
    publisher={Springer},
    doi={10.1007/s10683-011-9281-9},
    abstract = {In this paper we discuss laboratory experiments that address the problem of self-governance in an asymmetric commons dilemma. Small-scale irrigation systems that provide food for hundreds of millions of people around the world are probably the most common example of such dilemmas. Here, we formulate an abstract dilemma in which subjects make both a decision about investment in the provision of infrastructure associated with the use of a resource and about how much to extract from the common-pool resource made available by this infrastructure. The impact of inherent asymmetry in irrigation systems on the provision of a resource and the impact of communication on the capacity of the group to solve the two-level commons dilemma of cooperation and coordination based on the analysis of the experimental data are discussed.}
}

