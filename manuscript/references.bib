@article{amir2026emergence,
    author  = {Amir, Dorsa and Ahl, Rebecca E. and Jordan, Matthew R. and Bolotin, Henry and Bogese, Margaret and Gonz{\'a}lez, Gloria T. and Callaghan, Tara and Sugiyama, Lawrence S. and Otali, Emily and Tusiime, Phiona and Bangayan, Samantha and Snodgrass, J. Josh and McAuliffe, Katherine},
    title = {The emergence of cooperative behaviors, norms, and strategies across five diverse societies},
    journal = {Science Advances},
    volume = {12},
    number = {6},
    pages = {eadw9995},
    year = {2026},
    doi = {10.1126/sciadv.adw9995},
    URL = {https://www.science.org/doi/abs/10.1126/sciadv.adw9995},
    eprint = {https://www.science.org/doi/pdf/10.1126/sciadv.adw9995},
    abstract = {Human cooperation involves a set of interconnected behaviors that develop in conjunction with the cultural environment. Despite recent advances in Western, industrialized contexts, we know far less about how cooperative behaviors emerge across cultures, how normative environments shape their development, and how these behaviors relate to one another. Here, we examined the development of four cooperative behaviors—fairness, trustworthiness, forgiveness, and honesty—in children (N\&nbsp;=\&nbsp;413) aged 5 to 13 from five societies: urban United States, rural Uganda, Canada, Peru, and the hunter-horticulturalist Shuar of Ecuador. We also collected normative judgments from peers (N\&nbsp;=\&nbsp;163) and adults (N\&nbsp;=\&nbsp;86) of each community. We find substantial variation in cooperative behaviors and norms across populations, but, more generally, that children’s behaviors and norms tend to converge toward community-specific norms in middle childhood. We also identify three cooperative strategies—maximization, generic cooperation, and partner-contingent cooperation—whose prevalence shifts with age and differs across societies. Together, these findings illuminate how cooperative behavior develops within and across cultures. Children’s cooperative behaviors and norms develop along distinct cultural pathways shaped by local norms.}
}


